{
  "name": "open-cowork-chrome-extension",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:extension": "tsx esbuild.config.ts",
    "dev:ext": "tsx esbuild.config.ts --watch",
    "dev": "npm run dev:ext",
    "build:all": "npm run build:extension",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@opencode-ai/models": "^0.0.26",
    "onnxruntime-web": "1.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^24.12.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "description": "Open-source agentic browser control Chrome extension",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "adm-zip": "0.6.0",
    "sharp": ">=0.35.0",
    "onnxruntime-web": "1.27.0"
  }
