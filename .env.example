# Native MCP transport
OPEN_COWORK_TRANSPORT=stdio
OPEN_COWORK_DATA_DIR=~/.open-cowork

# Managed agent Chrome is the zero-setup default. It discovers Google Chrome,
# then creates one private persistent profile under OPEN_COWORK_DATA_DIR.
OPEN_COWORK_BROWSER_MODE=managed
# For an advanced DevTools connection, use mode=connect and set this endpoint.
# OPEN_COWORK_BROWSER_MODE=connect
# OPEN_COWORK_BROWSER_URL=http://127.0.0.1:9222
# For explicit launch mode, set a Chromium/Chrome executable.
# OPEN_COWORK_BROWSER_MODE=launch
# OPEN_COWORK_BROWSER_EXECUTABLE=/path/to/chrome
# OPEN_COWORK_BROWSER_HEADLESS=true
# OPEN_COWORK_BROWSER_USER_DATA_DIR=~/.open-cowork/browser
# OPEN_COWORK_BROWSER_AUTO_LAUNCH=false
# Test-only opt-in live suite override (the CI script discovers Chrome itself).
# OPEN_COWORK_TEST_BROWSER_EXECUTABLE=/path/to/chrome
# Browser output and operation bounds
OPEN_COWORK_BROWSER_TIMEOUT_MS=15000
OPEN_COWORK_BROWSER_CONNECT_TIMEOUT_MS=30000
OPEN_COWORK_BROWSER_CDP_TIMEOUT_MS=30000
OPEN_COWORK_MAX_SCREENSHOT_BYTES=8000000
OPEN_COWORK_MAX_HTML_CHARS=200000

# Network and page-operation safety invariants
OPEN_COWORK_ALLOWED_DOMAINS=
OPEN_COWORK_BLOCKED_DOMAINS=
OPEN_COWORK_ALLOW_PRIVATE_NETWORK=false
OPEN_COWORK_ALLOW_EVAL=false
# File uploads and generated PDFs stay inside these private roots by default.
# OPEN_COWORK_ALLOWED_FILE_ROOTS=~/.open-cowork/files,~/.open-cowork/downloads

# HTTP is opt-in; use a strong token before enabling remote access
# OPEN_COWORK_TRANSPORT=http
# OPEN_COWORK_HTTP_HOST=127.0.0.1
# OPEN_COWORK_HTTP_PORT=3344
# OPEN_COWORK_HTTP_PATH=/mcp
# OPEN_COWORK_HTTP_TOKEN=replace-with-at-least-32-random-characters
# OPEN_COWORK_ALLOW_REMOTE_HTTP=false
# OPEN_COWORK_HTTP_MAX_BODY_BYTES=2000000
# OPEN_COWORK_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# OPEN_COWORK_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]

OPEN_COWORK_LOG_LEVEL=info
