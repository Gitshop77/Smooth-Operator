{
  "name": "cowork-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Cowork Cockpit — Next.js 16 companion dashboard for the Open Cowork Chrome extension.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings 0",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:apply": "prisma migrate deploy"
  },
  "dependencies": {
