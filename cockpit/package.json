    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.5",
