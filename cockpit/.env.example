DATABASE_URL=file:./db/cowork.db

# Shared secret required on every /api/cowork/* route (cockpit
# middleware) AND on every mini-service HTTP/socket.io request. Set to a real
# secret (e.g. `openssl rand -hex 32`) — the cockpit middleware and
# mini-service both refuse the well-known `dev-token` default UNLESS the
# explicit `COWORK_ALLOW_DEV_TOKEN=1` opt-in is set (see below), and never in
# production (NODE_ENV=production) even with the opt-in.
#
# Generate a strong secret before deploying, e.g. `openssl rand -hex 32`.
# Leave this BLANK (not `dev-token`) to fail-closed in production — the
# middleware refuses an unset token.
COWORK_EVENT_TOKEN=

# Browser-facing UI auth token. MUST differ from COWORK_EVENT_TOKEN
# (which is service-to-service only and must NEVER be NEXT_PUBLIC). Generate e.g.
# `openssl rand -hex 32`. In dev/loopback you may set both to the same dev value,
# but in any untrusted network they MUST be distinct. The cockpit middleware
# prefers COWORK_UI_TOKEN for browser requests and falls back to COWORK_EVENT_TOKEN
# only for backward compatibility.
COWORK_UI_TOKEN=

# Browser-visible copy of the UI token, used by the cockpit
# dashboard's REST fetches (X-Cowork-Token) and socket.io handshake. Prefix with
# NEXT_PUBLIC_ so Next.js exposes it to client-side code. Prefer
# NEXT_PUBLIC_COWORK_UI_TOKEN (paired with server-side COWORK_UI_TOKEN). This
# legacy var is only a FALLBACK for the browser credential and must NOT be set
# equal to the service-to-service COWORK_EVENT_TOKEN on any untrusted network.
#
# ⚠️ DEPLOYMENT TRUST BOUNDARY: NEXT_PUBLIC_* values are embedded in the
# client bundle. Anyone loading the page can read this secret from the shipped
# JS, so the cockpit MUST NOT be deployed beyond localhost / a trusted intranet
# while using NEXT_PUBLIC_COWORK_EVENT_TOKEN / NEXT_PUBLIC_COWORK_UI_TOKEN. On any
# untrusted network the browser token is public and MUST NOT unlock the S2S secret.
#
# Generate a distinct value, e.g. `openssl rand -hex 32`. Leave this BLANK (not
# `dev-token`) — do not ship a ready-to-run dev value.
NEXT_PUBLIC_COWORK_UI_TOKEN=

# Browser-visible copy of the service-to-service token (legacy fallback):
# SHOULD NOT be used — use NEXT_PUBLIC_COWORK_UI_TOKEN instead. MUST match
# COWORK_EVENT_TOKEN ONLY if you intentionally run both as the same dev value on
# loopback; on any untrusted network they MUST be distinct. Prefix with
# NEXT_PUBLIC_ so Next.js exposes it to client-side code.
#
# ⚠️ DEPLOYMENT TRUST BOUNDARY: NEXT_PUBLIC_* values are embedded in the
# client bundle. Anyone loading the page can read this secret from the shipped
# JS. This is only a FALLBACK for the browser credential now that
# NEXT_PUBLIC_COWORK_UI_TOKEN exists.
NEXT_PUBLIC_COWORK_EVENT_TOKEN=

# Canonical base URL advertised in the agent bootstrap/manifest. Derive
# from a configured constant rather than the request's Host header to prevent
# host-header injection. Defaults to http://localhost:3000.
# COWORK_BASE_URL=http://localhost:3000

# CORS allowlist for the mini-service. The cockpit dashboard is
# same-origin and does not need CORS, but the mini-service answers direct
# socket.io/fetch calls from the browser. Defaults to http://localhost:3000.
# COWORK_CORS_ORIGIN=http://localhost:3000

COWORK_EVENTS_BASE_URL=http://localhost:3003

# Explicit opt-in to run with the well-known `dev-token` default. The
# cockpit middleware and the cowork-events mini-service now REFUSE the dev-token
# (and an UNSET token) unless this is '1'. Leave unset in every real/production
# deployment — production REQUIRES NODE_ENV=production AND a real
# COWORK_EVENT_TOKEN (e.g. `openssl rand -hex 32`). Dev-loopback only.
# COWORK_ALLOW_DEV_TOKEN=1

# Trusted upstream proxy IPs (comma-separated, e.g. "10.0.0.1,127.0.0.1").
# SECURITY: the brute-force auth throttle keys on the REAL client IP so an
# attacker cannot rotate X-Forwarded-For per request to reset the counter and
# brute-force the shared secret unthrottled. This only takes effect when set:
# with it UNSET, a directly-reachable deployment that trusts an attacker-
# controllable X-Forwarded-For lets the counter reset per request. YOU MUST set
# this to the IP(s) of your trusted reverse proxy / load balancer whenever the
# cockpit is reachable behind one; otherwise the rate-limit is effectively a
# no-op for an XFF-rotating attacker. Leave unset only for direct, loopback, or
# single-trusted-hop deployments where XFF is overwritten by the edge.
# COWORK_TRUSTED_PROXY_IPS=127.0.0.1

