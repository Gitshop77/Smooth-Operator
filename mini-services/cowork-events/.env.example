# cowork-events mini-service environment variables
#
# Copy to `.env` (or export in your shell) and adjust. The `.gitignore` at the
# repo root excludes `.env*` so a real secret pasted here won't be committed.

# Shared secret required on every REST route (except /health) and every
# socket.io connection. MUST match the cockpit's COWORK_EVENT_TOKEN (this is the
# SERVICE-TO-SERVICE secret — never NEXT_PUBLIC_). Set to a real secret before
# any non-loopback / production deployment:
#   COWORK_EVENT_TOKEN=$(openssl rand -hex 32)
# ⚠️ IMPORTANT: this value MUST NOT be the well-known `dev-token` in any
# non-loopback deployment — the service refuses to start (shouldRefuseStart)
# with `dev-token` unless COWORK_ALLOW_DEV_TOKEN=1 is explicitly set. Do NOT
# ship a ready-to-run dev value. Leave this BLANK/commented to fail-closed:
#   # COWORK_EVENT_TOKEN=  (set to a real secret; `openssl rand -hex 32`)
# Defaults to the well-known `dev-token` if unset (dev-loopback only).
# COWORK_EVENT_TOKEN=

# Explicit opt-in to run with the well-known `dev-token` default. The
# service REFUSES to start (and the cockpit middleware refuses the token) when
# the secret is the dev-token UNLESS this is '1'. Leave unset in every real /
# production deployment — production REQUIRES NODE_ENV=production AND a real
# COWORK_EVENT_TOKEN. Dev-loopback only.
# COWORK_ALLOW_DEV_TOKEN=1

# CORS allowlist for browser-side socket.io / fetch calls. The cockpit
# dashboard is same-origin and does not need CORS, but the service answers
# direct calls from the browser. Defaults to http://localhost:3000.
# COWORK_CORS_ORIGIN=http://localhost:3000

# When set to 'production', the service refuses to start with the default
# dev-token (unless COWORK_ALLOW_DEV_TOKEN=1). A real token is required in
# production regardless of NODE_ENV. Note: running via `npx tsx index.ts`
# without NODE_ENV set does NOT make the dev-token safe — the service refuses
# it unless COWORK_ALLOW_DEV_TOKEN=1 is explicitly set.
# NODE_ENV=production
